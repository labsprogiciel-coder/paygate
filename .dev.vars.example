ADMIN_API_KEY=change-me-to-a-long-random-string
# Clerk operator sign-in (optional): CLERK_PUBLISHABLE_KEY and CLERK_OPERATOR_IDS are vars in wrangler.jsonc; one of these checks the session
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
WEBHOOK_MASTER_SECRET=change-me-to-another-long-random-string
PAWAPAY_API_TOKEN=
PI_SP_API_CLIENT_ID=
PI_SP_API_CLIENT_SECRET=
PI_SPI_API_KEY=
PI_SPI_ACCOUNT_ALIAS=
ALERT_WEBHOOK_URL=
# Sentry error reporting (optional; off while empty)
SENTRY_DSN=
# The books copied to a Formance ledger (optional; the journal in D1 is kept either way). FORMANCE_URL is the stack, e.g. https://<org>-<stack>.<region>.formance.cloud
FORMANCE_URL=
FORMANCE_CLIENT_ID=
FORMANCE_CLIENT_SECRET=
# optional: the token endpoint (default /api/auth/oauth/token on FORMANCE_URL) and the ledger name (default paygate)
FORMANCE_TOKEN_URL=
FORMANCE_LEDGER=
