{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paygate",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/index.ts",
  "observability": { "enabled": true },
  // The operator console (public/). The Worker runs first for the API and callback paths; everything else is a static file.
  // The Worker also serves the page itself ("/"), to hand it the Clerk publishable key and a CSP that lets Clerk load.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/", "/index.html", "/v1/*", "/admin/*", "/callbacks/*", "/health"] },
  "triggers": {
    // every minute: deliver webhooks, settle payments whose callback was missed. Every fifth minute also checks the float.
    "crons": ["* * * * *"]
  },
  "vars": {
    "LIVE": "false",
    // "sandbox" pretends (no money moves, dev only, refused with LIVE=true) or "pawapay" (needs the PAWAPAY_API_TOKEN secret)
    "PROVIDER_MODE": "pawapay",
    // pawaPay API base: https://api.sandbox.pawapay.io (no money moves) or https://api.pawapay.io (production: only with LIVE=true)
    "PAWAPAY_BASE_URL": "https://api.sandbox.pawapay.io",
    // the largest single payment a tenant may make unless its own max_amount says otherwise (XOF)
    "DEFAULT_MAX_AMOUNT": "2000000",
    "CLERK_PUBLISHABLE_KEY": "pk_test_bGFzdGluZy1rcmlsbC0yMTIxLmNsZXJrLmFjY291bnRzLmRldiQ",
    "CLERK_OPERATOR_IDS": "user_3Kgna1fcv224zMXn81k6qWJNK02",
    // the per-country wallet floor the float check alerts below (XOF)
    "FLOAT_FLOOR_XOF": "2000000",
    // PI-SPI (BCEAO instant payments). Off unless PISPI_ENABLED is "true" and PI_SPI_ACCOUNT_ALIAS (secret) is set.
    "PISPI_ENABLED": "true",
    "PISPI_POLL": "true",
    "PISPI_RTP": "true",
    "PISPI_COUNTRY": "CI",
    "PI_SPI_PARTICIPANT": "CIC999",
    "PI_SPI_BUSINESS_API_URL": "https://no-mtls.piz.simulateurs.pi-bceao.com",
    "PI_SP_API_OAUTH_URL": "https://piz-simulateur-business-sandbox.auth.eu-west-1.amazoncognito.com/oauth2/token"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "paygate", "database_id": "122de81e-aef6-484a-a6d2-17ca34d5ce78", "migrations_dir": "migrations" }
  ],
  // Branch previews (Cloudflare Workers Builds runs `wrangler preview` on every PR). They must never touch production money or data:
  // simulated providers, PI-SPI off, not live, no Clerk (its sessions are tied to the production origin), and NO D1/KV bindings, so a
  // preview cannot read or write the production ledger. A preview serves the console and /health; anything needing the database errors.
  // To make previews fully usable, give them their own preview D1 database and KV namespace here (and apply the migrations to that D1).
  "previews": {
    "vars": {
      "LIVE": "false",
      "PROVIDER_MODE": "sandbox",
      "PAWAPAY_BASE_URL": "https://api.sandbox.pawapay.io",
      "DEFAULT_MAX_AMOUNT": "2000000",
      "FLOAT_FLOOR_XOF": "2000000",
      "CLERK_PUBLISHABLE_KEY": "",
      "CLERK_OPERATOR_IDS": "",
      "PISPI_ENABLED": "false",
      "PISPI_POLL": "false",
      "PISPI_RTP": "false",
      "PISPI_COUNTRY": "CI",
      "PI_SPI_PARTICIPANT": "",
      "PI_SPI_BUSINESS_API_URL": "",
      "PI_SP_API_OAUTH_URL": ""
    }
  },
  // the deployed version, so Sentry can tell which release an error came from
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Per-tenant budgets on /v1 (src/ratelimit.ts), keyed on the tenant id. period is 10 or 60 seconds. Counted per Cloudflare location.
  "ratelimits": [
    { "name": "WRITE_LIMIT", "namespace_id": "2401", "simple": { "limit": 60, "period": 60 } },
    { "name": "READ_LIMIT", "namespace_id": "2402", "simple": { "limit": 600, "period": 60 } }
  ],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "a65d284118964b7782cc2d58132d4863" }
  ]
  // Secrets (wrangler secret put): ADMIN_API_KEY, SENTRY_DSN, CLERK_SECRET_KEY, CLERK_JWT_KEY, WEBHOOK_MASTER_SECRET, PAWAPAY_API_TOKEN,
  // PI_SP_API_CLIENT_ID, PI_SP_API_CLIENT_SECRET, PI_SPI_API_KEY, PI_SPI_ACCOUNT_ALIAS, ALERT_WEBHOOK_URL,
  // FORMANCE_BASE_URL, FORMANCE_CLIENT_ID, FORMANCE_CLIENT_SECRET (optional: the books copied to a Formance ledger)
}
